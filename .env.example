# ---------- Free, local default (no API keys needed) ----------
CRAG_LLM=ollama
CRAG_MODEL=llama3.2:3b        # any model you have pulled with `ollama pull <name>`
CRAG_EMBED=ollama
CRAG_EVALUATOR=llm
CRAG_SEARCH=ddg

# ---------- Optional hosted backends ----------
# CRAG_LLM=groq                # needs GROQ_API_KEY and CRAG_MODEL=<a model from Groq's list>
# CRAG_LLM=openai              # needs OPENAI_API_KEY
# CRAG_EVALUATOR=llm           # use the LLM as the evaluator (many more calls)
# CRAG_SEARCH=tavily           # needs TAVILY_API_KEY

# ---------- Thresholds (tune these for your evaluator) ----------
 CRAG_UPPER=0.6
 CRAG_LOWER=0.3
 CRAG_STRIP=0.5
